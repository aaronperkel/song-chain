# Copy to .env.local and fill in. .env.local is gitignored.
#
# Spotify app: https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback
#   (Spotify rejects the "localhost" spelling; the loopback IP form is required.)
#   APIs used: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Added in step 3 (host auth). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENC_KEY=

# Added in step 3 (Supabase via the Vercel Marketplace; `vercel env pull`).
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
