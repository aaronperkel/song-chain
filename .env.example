# Copy to .env.local and fill in. .env.local is gitignored.
#
# Spotify app: https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback
#   (Spotify rejects the "localhost" spelling; the loopback IP form is required.)
#   APIs used: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Pins the origin used to build Spotify redirect URIs, which must
# match a dashboard entry byte for byte. Set this in production; locally the
# loopback IP is derived automatically.
# APP_ORIGIN=https://song-chain.vercel.app

# Added in step 3 (host auth). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENC_KEY=

# Supabase, injected by the Vercel Marketplace integration. Run:
#   vercel env pull
# The app uses POSTGRES_URL (pooled) and POSTGRES_URL_NON_POOLING (migrations).
